<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageIcon>waiter.png</PackageIcon>
    <ApplicationIcon>waiter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="waiter.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\waiter.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <EmbeddedResource Include="..\..\waiter.png">
      <LogicalName>waiter.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>